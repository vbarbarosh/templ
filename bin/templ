#
# How "Exit Traps" Can Make Your Bash Scripts Way More Robust And Reliable
# http://redsymbol.net/articles/bash-exit-traps/

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

cat $scriptdir/../templ.d/default
