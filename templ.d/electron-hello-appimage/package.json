{
  "name": "@vbarbarosh/electron-hello-appimage",
  "author": "Vladimir Barbarosh <vladimir.barbarosh@gmail.com>",
  "version": "0.0.0",
  "description": "",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux AppImage",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "bin/configure-unpkg"
  },
  "license": "ISC",
  "build": {
    "appId": "com.vbarbarosh.electron-hello-appimage",
    "productName": "electron-hello",
    "directories": {
      "buildResources": "ubuntu",
      "output": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "executableName": "electron-hello",
      "artifactName": "app.AppImage"
    }
  },
  "dependencies": {
    "@vbarbarosh/node-helpers": "3.75.0",
    "@vbarbarosh/type-helpers": "0.2.0",
    "bluebird": "3.7.2"
  },
  "devDependencies": {
    "electron": "42.5.0",
    "electron-builder": "26.15.3"
  }
}
