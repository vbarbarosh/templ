<clickhouse>
    <!-- Passwordless user for the local nginx proxy only. It can read the log
         table but cannot insert, mutate, manage users, or change settings. -->
    <profiles>
        <log_ui_readonly>
            <readonly>1</readonly>
            <max_execution_time>30</max_execution_time>
            <max_threads>4</max_threads>
        </log_ui_readonly>
    </profiles>

    <users>
        <log_ui>
            <password></password>
            <networks>
                <ip>10.0.0.0/8</ip>
                <ip>172.16.0.0/12</ip>
                <ip>192.168.0.0/16</ip>
            </networks>
            <profile>log_ui_readonly</profile>
            <quota>default</quota>
            <access_management>0</access_management>
            <grants>
                <query>GRANT SELECT ON default.otel_logs</query>
            </grants>
        </log_ui>
    </users>
</clickhouse>
